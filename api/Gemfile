source "https://rubygems.org"

gem "rails", "~> 8.1.3"

# Banco relacional (Postgres rodando em localhost:25432 via docker-compose)
gem "pg", "~> 1.5"

# Banco documento (Mongo rodando em localhost:27027 via docker-compose)
gem "mongoid", "~> 9.0"

# Servidor
gem "puma", ">= 5.0"

# Auth
gem "bcrypt", "~> 3.1"
gem "jwt", "~> 2.8"

# Authorization
gem "pundit", "~> 2.4"

# Money handling (monetize, currency arithmetic)
gem "money-rails", "~> 1.15"

# CORS
gem "rack-cors", "~> 2.0"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Deploy this application anywhere as a Docker container [https://kamal-deploy.org]
gem "kamal", require: false

# Add HTTP asset caching/compression and X-Sendfile acceleration to Puma
gem "thruster", require: false

# Use Active Storage variants
gem "image_processing", "~> 1.2"

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  gem "dotenv-rails"

  gem "rspec-rails", "~> 7.1"
  gem "factory_bot_rails", "~> 6.4"

  # Audits gems for known security defects
  gem "bundler-audit", require: false

  # Static analysis for security vulnerabilities
  gem "brakeman", require: false

  # Omakase Ruby styling
  gem "rubocop-rails-omakase", require: false
end

group :test do
  gem "shoulda-matchers", "~> 6.4"
  gem "database_cleaner-active_record"
  gem "database_cleaner-mongoid"
end
